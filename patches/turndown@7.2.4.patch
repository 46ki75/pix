       replacement = replacementForNode.call(self, node);
     }
+    // Invisible boundaries keep generated inline delimiters from merging or becoming intraword text.
+    if (!parentNode.isCode && lastCharacter && replacement &&
+        !/\s/.test(lastCharacter) && !/^\s/.test(replacement) &&
+        (/[*_`]/.test(lastCharacter) || /^[*_`]/.test(replacement))) {
+      replacement = '<!-- -->' + replacement;
