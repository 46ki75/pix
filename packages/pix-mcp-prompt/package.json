{
  "name": "@ikuma.cloud/pix-mcp-prompt",
  "version": "0.0.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "User-selected MCP prompts for Pi's native MCP configuration",
  "keywords": [
    "pi-package"
  ],
  "files": [
