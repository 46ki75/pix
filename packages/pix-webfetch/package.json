{
  "name": "@ikuma.cloud/pix-webfetch",
  "version": "0.0.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Fetch web pages as Markdown or readable text for Pi Coding Agent",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "exports": {
    "./core": {
      "development": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "entities": "7.0.1",
    "html-to-text": "10.0.1",
    "htmlparser2": "10.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/html-to-text": "9.0.4"
  }
}
