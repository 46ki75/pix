{
  "name": "@ikuma.cloud/pix-webfetch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fetch web pages as Markdown or readable text for Pi Coding Agent",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "entities": "7.0.1",
    "html-to-text": "10.0.1",
    "htmlparser2": "10.1.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/html-to-text": "9.0.4",
    "@types/turndown": "5.0.6"
  }
}
